{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "schedule:monthly",
    ":maintainLockFilesMonthly",
    ":disableRateLimiting"
  ],
  "enabledManagers": [
    "npm",
    "github-actions",
    "nvm",
    "custom.regex"
  ],
  "labels": [
    "dependencies"
  ],
  "dependencyDashboard": true,
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update Node.js runtime in action metadata",
      "managerFilePatterns": [
        "/^action\\.ya?ml$/"
      ],
      "matchStrings": [
        "using:\\s*\"node(?<currentValue>\\d+)\""
      ],
      "depNameTemplate": "node",
      "datasourceTemplate": "node-version",
      "versioningTemplate": "node",
      "extractVersionTemplate": "^(?<version>\\d+)"
    }
  ],
  "packageRules": [
    {
      "description": "Only propose even Node.js majors for action runtime",
      "matchManagers": [
        "custom.regex"
      ],
      "matchPackageNames": [
        "node"
      ],
      "allowedVersions": "/^\\d*[02468]$/"
    },
    {
      "description": "Dev tooling grouped into one PR",
      "matchDepTypes": [
        "devDependencies"
      ],
      "groupName": "dev tooling"
    },
    {
      "description": "CI actions grouped into one PR",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github actions"
    },
    {
      "description": "Keep Node.js types on the action runtime major (node24 in action.yml)",
      "matchPackageNames": [
        "@types/node"
      ],
      "allowedVersions": "24.x"
    },
    {
      "description": "Keep local Node.js on the action runtime major (node24 in action.yml)",
      "matchManagers": [
        "nvm"
      ],
      "allowedVersions": "24.x"
    },
    {
      "description": "typescript-eslint does not support TypeScript 7 yet",
      "matchPackageNames": [
        "typescript"
      ],
      "allowedVersions": "<7"
    }
  ]
}
